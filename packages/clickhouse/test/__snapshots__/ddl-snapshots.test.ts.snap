// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ClickHouse DDL Snapshots > All field types DDL output > should match snapshot for all types schema 1`] = `
"CREATE TABLE IF NOT EXISTS all_types
(
    string_field String,
    text_field String,
    int_field Int32,
    long_field Int64,
    bigint_field Int64,
    float_field Float32,
    double_field Float64,
    bool_field Bool,
    boolean_field Bool,
    uuid_field UUID,
    timestamp_field DateTime64(3),
    timestamptz_field DateTime64(3),
    date_field Date,
    time_field String,
    json_field JSON,
    binary_field String,
    decimal_field Decimal(38, 9),
    string_array Array(String),
    int_array Array(Int32),
    uuid_array Array(UUID)
)
ENGINE = MergeTree()
ORDER BY (uuid_field)"
`;

