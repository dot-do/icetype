exports[`ClickHouse DDL Snapshots > Indexes and constraints DDL output > should match snapshot for indexed schema with TTL 1`] = `
"CREATE TABLE IF NOT EXISTS product
(
    id UUID,
    sku String,
    name String,
    price Decimal(38, 9),
    quantity Int32,
    is_active Bool,
    created_at DateTime64(3)
)
ENGINE = MergeTree()
ORDER BY (id)
TTL created_at + INTERVAL 30 DAY"
`;

exports[`ClickHouse DDL Snapshots > Indexes and constraints DDL output > should match snapshot for indexed schema with partition 1`] = `
