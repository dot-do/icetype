exports[`ClickHouse DDL Snapshots > ClickHouse-specific features DDL output > should match snapshot for schema with SETTINGS 1`] = `
"CREATE TABLE IF NOT EXISTS \`user\`
(
    id UUID,
    email String,
    name String,
    age Nullable(Int32)
)
ENGINE = MergeTree()
ORDER BY (id)
SETTINGS index_granularity = 8192, storage_policy = 'fast_ssd'"
`;

exports[`ClickHouse DDL Snapshots > ClickHouse-specific features DDL output > should match snapshot for schema with SummingMergeTree 1`] = `
"CREATE TABLE IF NOT EXISTS metrics
(
    id UUID,
    \`date\` Date,
    count Int32,
    total Float64
)
ENGINE = SummingMergeTree()
ORDER BY (id, \`date\`)"
`;

exports[`ClickHouse DDL Snapshots > ClickHouse-specific features DDL output > should match snapshot for schema with partition by date 1`] = `
"CREATE TABLE IF NOT EXISTS \`events\`
(
    id UUID,
    event_type String,
    created_at DateTime64(3),
    data JSON
)
ENGINE = MergeTree()
PARTITION BY toYYYYMM(created_at)
ORDER BY (created_at, id)"
`;

exports[`ClickHouse DDL Snapshots > Complex schema with relations DDL output > should match snapshot for complex schema 1`] = `
"CREATE TABLE IF NOT EXISTS post
(
    id UUID,
    title String,
    content String,
    author_id String,
    category_id Nullable(String),
    published_at Nullable(DateTime64(3)),
    view_count Int32,
    is_published Bool,
    metadata JSON,
    tags Array(String)
)
ENGINE = MergeTree()
ORDER BY (id)"
`;

exports[`ClickHouse DDL Snapshots > Complex schema with relations DDL output > should match snapshot for complex schema with all options 1`] = `
"CREATE TABLE IF NOT EXISTS blog.post
(
    id UUID,
    title String,
    content String,
    author_id String,
    category_id Nullable(String),
    published_at Nullable(DateTime64(3)),
    view_count Int32,
    is_published Bool,
    metadata JSON,
    tags Array(String)
)
ENGINE = ReplacingMergeTree()
ORDER BY (id)"
`;

