exports[`ClickHouse DDL Snapshots > Edge case DDL output > should match snapshot for schema with all modifiers 1`] = `
"CREATE TABLE IF NOT EXISTS modifiers
(
    required_field String,
    optional_field Nullable(String),
    unique_field String,
    required_unique String,
    array_field Array(String)
)
ENGINE = MergeTree()
ORDER BY (required_field)"
`;

